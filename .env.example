# Uygulama derlenirken gömülen ayarlar.
# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` commit EDİLMEZ.
#
# EXPO_PUBLIC_ ön ekli değişkenler JS paketine gömülür; yani APK'dan
# okunabilirler. Buraya ASLA Anthropic API anahtarı yazma — anahtar yalnızca
# Cloudflare Worker'ın gizli değişkeninde durur (server/README.md).

# Yorum vekilinin adresi. Doluysa uygulama kutudan çıktığı gibi yapay zekâ
# yorumu verir; kullanıcı hiçbir ayar yapmak zorunda kalmaz.
EXPO_PUBLIC_AI_PROXY_URL=https://dogum-haritasi-proxy.HESABIN.workers.dev/interpret

# Worker'da APP_TOKEN tanımladıysan aynısı. Bu da paketten okunabilir; amacı
# güvenlik değil, uç noktanın rastgele kullanılmasını zorlaştırmaktır.
# Asıl koruma: Cloudflare hız sınırı + Anthropic Console harcama limiti.
EXPO_PUBLIC_AI_PROXY_TOKEN=
